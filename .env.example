# docker-compose 용 환경변수 템플릿.
# 이 파일을 `.env` 로 복사한 뒤 실제 값으로 채운다. (.env 는 커밋 금지)

# ── 필수 ──
DB_PASSWORD=change-me-strong-password        # PostgreSQL 비밀번호
GEMINI_API_KEY=your-gemini-api-key           # 가중치·AI 설명·보고서 생성용

# ── 인증 (JWT + 구글 OAuth) ──
SECRET_KEY=change-me-random-32bytes-or-more  # JWT 서명키(운영 필수 교체). 예) python -c "import secrets;print(secrets.token_urlsafe(48))"
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com  # 없으면 구글로그인 비활성
ALLOW_STUB_LOGIN=true                         # 이메일 스텁 로그인 허용(데모 true, 운영 false 권장)

# ── 프론트/CORS (기본값이면 생략 가능) ──
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# ── 선택: 신규 품목 build-sgri 데이터 수집용 (없으면 기존 품목만 동작) ──
COMTRADE_API_KEY=
CUSTOMS_API_KEY=
FRED_API_KEY=
ECOS_API_KEY=
