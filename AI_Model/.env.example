# Copy this file to .env. Never commit the real .env file.
# Gemini 3.6 Flash free tier: weights, company recommendations, report drafts.
# Final SGRI scores are calculated by Python.
GEMINI_API_KEY=

# Free data APIs that require a key.
CUSTOMS_API_KEY=
COMTRADE_API_KEY=
FRED_API_KEY=
ECOS_API_KEY=

# Free no-key PortWatch endpoint; override only if IMF changes the service.
PORTWATCH_FEATURE_URL=https://services9.arcgis.com/weJ1QsnbMYJlCHdG/ArcGIS/rest/services/Daily_Ports_Data/FeatureServer/0/query

# Free official data files, not APIs.
CBAM_DATA_PATH=
LCI_DATA_PATH=

# PostgreSQL: use DATABASE_URL or the individual DB_* variables.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=supplyguard
DB_USER=postgres
DB_PASSWORD=
